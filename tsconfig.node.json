{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite/**/*.ts", "vitest.config.ts", "vitest.worker.config.ts", "playwright.config.ts", "tests/e2e/**/*.ts"]
}
