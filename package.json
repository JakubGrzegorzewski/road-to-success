{
  "name": "road-to-success",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:worker",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "pdfmake": "^0.3.12",
    "qrcode": "^1.5.4",
    "vue": "^3.5.17",
    "vue-i18n": "11.1.10",
    "vue-router": "^4.5.1",
    "vuetify": "^3.11.0",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "axios": "^1.18.0",
    "postcss": "^8.5.10",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  }
}
